rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return userExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function validRole(value) {
      return value in ['client', 'staff', 'admin', 'superadmin'];
    }
    function validStatus(value) {
      return value in ['active', 'suspended'];
    }
    function isStaff() { return role() in ['staff', 'admin', 'superadmin']; }
    function isAdmin() { return role() in ['admin', 'superadmin']; }
    function isSuper() { return role() == 'superadmin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsExisting(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }
    function ownsIncoming(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }

    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.email is string;
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /newsletter/{id} {
      allow create: if request.resource.data.email is string;
      allow read, delete: if isStaff();
    }
    match /blog/{id} { allow read: if true; allow write: if isStaff(); }
    match /portfolio/{id} { allow read: if true; allow write: if isStaff(); }
    match /testimonials/{id} { allow read: if true; allow write: if isStaff(); }

    match /users/{uid} {
      // A client may create only its own client profile.
      // Staff accounts are created by a verified superadmin from the Super Admin page.
      allow create: if (isOwner(uid)
        && request.resource.data.role == 'client')
        || (isSuper()
          && validRole(request.resource.data.role)
          && validStatus(request.resource.data.status));

      allow read: if isOwner(uid) || isStaff();

      // Superadmin can change another user's role/status, but cannot remove its own access.
      allow update: if isSuper()
        && uid != request.auth.uid
        && validRole(request.resource.data.role)
        && validStatus(request.resource.data.status)
        || (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));

      allow delete: if isSuper() && uid != request.auth.uid;
    }
    match /roles/{id} { allow read: if signedIn(); allow write: if isSuper(); }

    match /clients/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid);
      allow update: if isStaff() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifetimeValue']));
      allow delete: if isAdmin();
    }
    match /projects/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow create: if ownsIncoming('clientId') || isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /invoices/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow create, update, delete: if isStaff();
    }
    match /payments/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow create: if false;
      allow update, delete: if isAdmin();
    }
    match /tickets/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow create: if ownsIncoming('clientId') || isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if ownsExisting('userId') || isStaff();
      allow create: if isStaff();
      allow update: if ownsExisting('userId') || isStaff();
      allow delete: if isStaff();
    }
    match /messages/{id} {
      allow read: if isStaff() || ownsExisting('senderId') || ownsExisting('clientId');
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isStaff() || ownsExisting('senderId');
      allow delete: if isAdmin();
    }
    match /contracts/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow write: if isStaff();
    }
    match /proposals/{id} {
      allow read: if ownsExisting('clientId') || isStaff();
      allow write: if isStaff() || ownsExisting('clientId');
    }
    match /files/{id} {
      allow read: if isStaff() || ownsExisting('clientId') || ownsExisting('uploadedBy');
      allow create: if isStaff() || ownsIncoming('clientId');
      allow delete: if isStaff() || ownsExisting('uploadedBy');
    }

    match /tasks/{id} { allow read, write: if isStaff(); }
    match /employees/{id} { allow read, write: if isStaff(); }
    match /timeLogs/{id} {
      allow read: if isStaff() || ownsExisting('userId');
      allow create: if isStaff() || ownsIncoming('userId');
      allow update: if isStaff() || ownsExisting('userId');
      allow delete: if isAdmin();
    }
    match /expenses/{id} { allow read, write: if isStaff(); allow delete: if isAdmin(); }

    match /repos/{id} { allow read, write: if isStaff(); }
    match /environments/{id} { allow read, write: if isStaff(); }
    match /deployments/{id} { allow read, write: if isStaff(); }
    match /devLogs/{id} { allow read, write: if isStaff(); }
    match /monitors/{id} { allow read, write: if isStaff(); }
    match /apiKeys/{id} { allow read, write: if isAdmin(); }

    match /auditLogs/{id} {
      allow read: if isSuper();
      allow create: if isStaff() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /settings/{id} {
      allow read: if id == 'general' || signedIn();
      allow write: if isSuper();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
